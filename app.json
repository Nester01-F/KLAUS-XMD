{
  "name": "KLAUS XMD",
  "description": "Powerful WhatsApp bot built with Baileys",
  "repository": "https://github.com/Nester01-F/KLAUS-XMD",
  "logo": "https://files.catbox.moe/maj8xu.jpg",
  "keywords": ["whatsapp", "bot", "baileys", "klaus"],
  "env": {
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number (no +, e.g. 2547XXXXXXXX)",
      "required": true
    },
    "PREFIX": {
      "description": "Command prefix",
      "value": "."
    },
    "SESSION_ID": {
      "description": "Base64 session ID (from local run)",
      "required": false
    }
  },
  "buildpacks": [
    { "url": "heroku/nodejs" },
    { "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git" }
  ],
  "formation": {
    "worker": { "quantity": 1, "size": "basic" }
  }
}